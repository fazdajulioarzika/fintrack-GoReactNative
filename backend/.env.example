# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env ke GitHub.
PORT=8080
APP_ENV=development

# Dari MongoDB Atlas: Connect > Drivers > salin connection string
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=fintrack

# Buat dengan: openssl rand -base64 48   (minimal 32 karakter)
JWT_SECRET=ganti-dengan-string-acak-panjang

ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
